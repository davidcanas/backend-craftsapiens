// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Stats {
    id           String        @id @default(cuid()) @map("_id") @db.ObjectId
    createdAt    DateTime      @map("first_login") @db.Date
    lastLogin    DateTime      @map("last_login") @db.Date

    money        Int           @map("money") @db.Int64
    transactions Transaction[] @map("transactions")
}

model Transaction {
    id         String   @id @default(cuid()) @map("_id") @db.ObjectId

    stats      Stats    @relation(fields: [statsId], references: [id])
    statsId    String   @db.ObjectId

    receiver   User     @relation(fields: [receiverId], references: [id])
    receiverId String   @db.ObjectId

    createdAt  DateTime @map("created_at") @db.Date
    amount     Int      @db.Int64
    type       String
}

model User {
    uuid  String @unique @default(cuid()) @map("_id") @db.ObjectId
    name  String @unique
    stats Stats
}
